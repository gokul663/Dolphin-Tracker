# Copy to .env.local for local overrides. Vite exposes only VITE_* variables to the browser.
VITE_API_BASE_URL=/api
VITE_GOOGLE_MAPS_BROWSER_KEY=
# Sign-in. off: no login (the API's sign-in is off too, DT_AUTH_MODE=off). cognito: the shared Dolphin Nexus login,
# its Cognito user pool's managed login page; the API then needs DT_AUTH_MODE=jwt and the matching DT_AUTH_* values.
VITE_AUTH_MODE=off
VITE_COGNITO_USER_POOL_ID=us-east-1_U2DnRTmXT
# The "dolphin-tracker" app client: output TrackerClientId of the Nexus deploy.
VITE_COGNITO_CLIENT_ID=1cpblkn568vqoogddkfl64br7g
VITE_COGNITO_DOMAIN=dolphin-keystone.auth.us-east-1.amazoncognito.com
# Empty: the login page shows Google and the password form (technicians outside @dolphin-digital.com use a
# password). "Google" skips that page and goes straight to Google.
VITE_COGNITO_PROVIDER=
